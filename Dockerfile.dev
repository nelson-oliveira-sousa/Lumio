# Toolchain de desenvolvimento (Ruby + Node) para uso opcional em devcontainer/CI.
# Não copia Gemfile/package.json: eles ainda não existem no repo (chegam no LUM-03).
# O código da aplicação é montado como volume, não copiado para a imagem.
FROM ruby:3.3-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    postgresql-client \
    curl \
    git \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g yarn \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
